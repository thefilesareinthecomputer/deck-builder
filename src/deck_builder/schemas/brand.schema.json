{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deck-builder/brand.schema.json",
  "title": "brand.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "name", "slug", "version", "palette"],
  "$defs": {
    "hex": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
    "relpath": {"type": "string", "minLength": 1, "pattern": "^(?![/\\\\~])(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$"},
    "colorRef": {"type": "string", "minLength": 1},
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "fallback": {"type": "string"},
        "files": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "properties": {
    "spec_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "description": {"type": "string"},
    "palette": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {"$ref": "#/$defs/hex"}
    },
    "theme_colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dk1": {"$ref": "#/$defs/colorRef"}, "lt1": {"$ref": "#/$defs/colorRef"},
        "dk2": {"$ref": "#/$defs/colorRef"}, "lt2": {"$ref": "#/$defs/colorRef"},
        "accent1": {"$ref": "#/$defs/colorRef"}, "accent2": {"$ref": "#/$defs/colorRef"},
        "accent3": {"$ref": "#/$defs/colorRef"}, "accent4": {"$ref": "#/$defs/colorRef"},
        "accent5": {"$ref": "#/$defs/colorRef"}, "accent6": {"$ref": "#/$defs/colorRef"},
        "hlink": {"$ref": "#/$defs/colorRef"}, "folHlink": {"$ref": "#/$defs/colorRef"}
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"heading": {"$ref": "#/$defs/font"}, "body": {"$ref": "#/$defs/font"}}
    },
    "logos": {"type": "object", "additionalProperties": {"$ref": "#/$defs/relpath"}},
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir"],
      "properties": {
        "dir": {"$ref": "#/$defs/relpath"},
        "default_color": {"$ref": "#/$defs/colorRef"},
        "source": {"type": "string"}
      }
    },
    "voice": {"type": "array", "items": {"type": "string"}},
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_slides": {"type": "integer", "minimum": 1},
        "banned_patterns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "generate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slide_size": {"enum": ["16:9", "4:3"]},
        "layout_set": {"enum": ["minimal", "standard", "full", "designed"], "description": "designed: full, plus a section label and subtitle on content slides and the cards, process and bands layouts"},
        "logo_on_master": {"type": "string"},
        "slide_numbers": {"type": "boolean", "description": "a slide number on layouts that show the master (default true)"},
        "type": {
          "type": "object",
          "additionalProperties": false,
          "description": "type sizes in points; any key left out keeps its default",
          "properties": {
            "title": {"type": "number", "minimum": 12, "maximum": 72, "description": "content-slide titles (default 32)"},
            "title_bold": {"type": "boolean", "description": "bold content-slide titles (default true)"},
            "subtitle": {"type": "number", "minimum": 10, "maximum": 48, "description": "title and closing slide subtitles (default 24)"},
            "body": {"type": "number", "minimum": 10, "maximum": 48, "description": "single-column body text; the agenda is 4 pt larger (default 24)"},
            "two_col": {"type": "number", "minimum": 10, "maximum": 40, "description": "two-column, comparison and image-right text (default 20)"},
            "icon_text": {"type": "number", "minimum": 10, "maximum": 36, "description": "icon-row text (default 18)"},
            "table": {"type": "number", "minimum": 8, "maximum": 32, "description": "table text, header included (default 16)"},
            "big_number": {"type": "number", "minimum": 48, "maximum": 200, "description": "the big-number numeral (default 120)"},
            "kicker": {"type": "number", "minimum": 9, "maximum": 24, "description": "designed set: the section label above a content title (default 18)"},
            "lede": {"type": "number", "minimum": 12, "maximum": 32, "description": "designed set: the subtitle line under a content title (default 20)"}
          }
        },
        "mode": {"enum": ["projected", "read"], "description": "projected decks are presented to a room; read decks are sent and read on a screen: smaller type, a 9 in text measure, text from the top (default projected)"},
        "body_anchor": {"enum": ["middle", "top"], "description": "where single-column body text sits in its area (default middle)"},
        "big_number": {"enum": ["light", "dark"], "description": "the big-number slide on the background color, or on the primary color like a section slide (default light)"},
        "takeaway": {"enum": ["band", "quote"], "description": "the takeaway line: a full-width band in the primary color, or an italic line in the primary color centered under the content (default band)"},
        "emphasis": {"enum": ["primary", "ink"], "description": "designed set: the color of **bold** text on cards and bands (default primary)"},
        "icons": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"tile": {"enum": ["none", "square", "circle"], "description": "icon-row icons on a primary-color tile, drawn white (default none)"}}
        },
        "bands": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"label_shape": {"enum": ["parallelogram", "rectangle"], "description": "designed set: the label shape on bands layouts (default parallelogram)"}}
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"icons": {"type": "boolean", "description": "designed set: each process step holds a white icon, with its title under the arrow (default false)"}}
        }
      }
    }
  }
}
