{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deck-builder/tokens.schema.json",
  "title": "tokens.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["layouts"],
  "$defs": {
    "colorRef": {"type": "string", "minLength": 1},
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idx", "kind"],
      "properties": {
        "idx": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["text", "bullets", "table", "chart", "image", "icon", "code"]},
        "required": {"type": "boolean"},
        "max_chars": {"type": "integer", "minimum": 1},
        "max_bullets": {"type": "integer", "minimum": 1},
        "max_bullet_chars": {"type": "integer", "minimum": 1},
        "max_level": {"type": "integer", "minimum": 0},
        "max_rows": {"type": "integer", "minimum": 1},
        "max_cols": {"type": "integer", "minimum": 1, "description": "tables: columns; code: characters a line holds"},
        "color": {"$ref": "#/$defs/colorRef"},
        "emphasis": {"$ref": "#/$defs/colorRef", "description": "text fields: the color of **bold** runs"},
        "line_chars": {"type": "integer", "minimum": 1, "description": "text fields: characters a line holds, which check wraps the text at"},
        "max_lines": {"type": "number", "exclusiveMinimum": 0, "description": "text fields: lines the box holds; check estimates the wrapped text, bullet spacing included, against it. code: lines the panel holds"},
        "fit": {"type": "boolean", "description": "image fields: always fit the image inside the box, never crop it"},
        "fit_max": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "image fields: a fitted image takes at most this share of the box"}
      }
    }
  },
  "properties": {
    "spec_version": {"const": 1},
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"code_font": {"type": "string"}}
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "description": "code blocks: written by brand init, each role color at 4.5:1 on the panel and the highlight band",
      "properties": {
        "theme": {"enum": ["light", "dark"]},
        "panel": {"$ref": "#/$defs/colorRef"},
        "highlight": {"$ref": "#/$defs/colorRef"},
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keyword": {"$ref": "#/$defs/colorRef"}, "string": {"$ref": "#/$defs/colorRef"},
            "comment": {"$ref": "#/$defs/colorRef"}, "number": {"$ref": "#/$defs/colorRef"},
            "function": {"$ref": "#/$defs/colorRef"}, "type": {"$ref": "#/$defs/colorRef"},
            "operator": {"$ref": "#/$defs/colorRef"}, "plain": {"$ref": "#/$defs/colorRef"}
          }
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": {"type": "string"},
        "font_size": {"type": "number", "exclusiveMinimum": 0},
        "text_color": {"$ref": "#/$defs/colorRef"},
        "gridlines": {"type": "boolean"},
        "gridline_color": {"$ref": "#/$defs/colorRef"},
        "axis_text_color": {"$ref": "#/$defs/colorRef", "description": "axis labels, the category axis line and the legend; text_color when left out"},
        "gap_width": {"type": "integer", "minimum": 0},
        "line_width": {"type": "number", "exclusiveMinimum": 0},
        "colors": {"type": "array", "items": {"$ref": "#/$defs/colorRef"}}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": {"type": "string"},
        "font_size": {"type": "number", "exclusiveMinimum": 0},
        "header_font_size": {"type": "number", "exclusiveMinimum": 0},
        "row_height": {"type": "number", "exclusiveMinimum": 0},
        "row_height_factor": {"type": "number", "exclusiveMinimum": 0},
        "header_fill": {"$ref": "#/$defs/colorRef"},
        "header_text": {"$ref": "#/$defs/colorRef"},
        "row_fill": {"$ref": "#/$defs/colorRef"},
        "band_fill": {"$ref": "#/$defs/colorRef"},
        "rule": {"$ref": "#/$defs/colorRef"},
        "text": {"$ref": "#/$defs/colorRef"},
        "status": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/colorRef"}
        }
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "description": "written by brand init: the deck-builder that generated the kit and a hash of what shaped its template (brand.yaml's palette, theme colors, fonts and generate settings, and the master logo), so brand check can say when the kit is stale",
      "properties": {"by": {"type": "string"}, "inputs_sha256": {"type": "string"}}
    },
    "furniture": {
      "type": "object",
      "additionalProperties": false,
      "description": "written by brand init: whether layouts have slide numbers, and the color chosen for numbers and footers",
      "properties": {"slide_numbers": {"type": "boolean"}, "color": {"$ref": "#/$defs/colorRef"}}
    },
    "layouts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template_layout", "fields"],
        "properties": {
          "template_layout": {"type": "string", "minLength": 1},
          "master": {"type": ["string", "null"]},
          "heading_field": {"type": "string"},
          "description": {"type": "string"},
          "row": {"type": "boolean", "description": "the build spaces the filled numbered slots (logo1, caption1 ...) evenly across the row"},
          "fields": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
            "additionalProperties": {"$ref": "#/$defs/field"}
          }
        }
      }
    }
  }
}
