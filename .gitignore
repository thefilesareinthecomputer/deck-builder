# Allowlist: everything is ignored unless listed here, so user, workspace and client files
# can't be committed by accident. A new top-level file or folder has to be added below.
/*
!/.gitignore
!/.github/
!/.claude/
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/CHANGELOG.md
!/LICENSE
!/pyproject.toml
!/uv.lock
!/src/
!/tests/
!/docs/
!/scripts/
!/workspace/
# tasks/ (plans, handoffs, the archived design spec) is local working notes and never ships

# .claude ships only the skills and the agent; local settings stay local
/.claude/*
!/.claude/skills/
!/.claude/agents/

# workspace/ ships as an empty placeholder; init fills it locally
/workspace/*
!/workspace/README.md

# secrets, anywhere, even inside allowlisted folders
.env
.env.*
*.pem
*.key
*.p12

# generated anywhere
__pycache__/
*.py[cod]
*.render/
.DS_Store
